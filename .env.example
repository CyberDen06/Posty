# Posty environment — copy to .env and fill in. Never commit real secrets.
# Server
PORT=3000
SESSION_SECRET=
DATA_DIR=./data

# Buffer OAuth app (register at Buffer Settings > API; confidential client)
# Buffer requires https redirect URIs — http://localhost is rejected with a
# generic error. Register https://localhost:3443/auth/buffer/callback locally
# (served by the TLS listener below) or your public /auth/buffer/callback.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3443/auth/buffer/callback

# Local TLS listener (https on TLS_PORT) so the Buffer callback has an https
# address. Either a PFX bundle (Windows: New-SelfSignedCertificate for
# 'localhost', exported with a password) or PEM key/cert files.
TLS_PORT=3443
TLS_PFX=./data/certs/localhost.pfx
TLS_PASSPHRASE=
# TLS_KEY=./data/certs/localhost-key.pem
# TLS_CERT=./data/certs/localhost-cert.pem

# Exa general web search (https://dashboard.exa.ai/api-keys). Joins Hacker News,
# GDELT, and Reddit in discovery and powers Ask Posty. Paid per search
# (~$0.007/auto search; $10 free monthly credits). Unset = keyless built-ins.
EXA_API_KEY=

# Optional: NewsAPI key enables the NewsAPI adapter for LOCAL development only.
# Its licensing/freshness/terms are not cleared for deployed use — see README.
NEWS_API_KEY=

# LLM drafting + grounded comment snapshots (Muse / Meta Model API,
# OpenAI-compatible). When unset, Posty uses its built-in template engine
# (no external calls, no invented opinions).
LLM_API_KEY=
LLM_ENDPOINT=https://api.meta.ai/v1/chat/completions
LLM_MODEL=muse-spark-1.3

# Voice transcription (Muse Voice Transcribe). Uses LLM_API_KEY; override the
# model only if Meta ships a newer one. WAV-only, ≤10 min audio, ≤32 MB.
LLM_VOICE_MODEL=muse-voice-transcribe-1.0

# Vercel deployment: KV store (Upstash-backed) replaces local files.
# Created automatically when you add a KV database in the Vercel dashboard
# Storage tab and connect it to the project. SESSION_SECRET is REQUIRED
# on Vercel (instances do not share memory).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Scheduled routines: long random string guarding GET /api/cron/routine.
# The GitHub Actions workflow (.github/workflows/routine-cron.yml) calls it
# weekly with this same value from repo secrets. Unset = on-demand only.
CRON_SECRET=

# Test helper: when "1" and Buffer OAuth is NOT configured, mock scheduling
# fails on demand so the error/retry UI can be exercised. Labeled simulated.
MOCK_FAIL=

# Desktop companion (Windows): npm start launches it automatically.
# POSTY_NO_DESKTOP=1 opts out; POSTY_URL points it at a deployed server;
# POSTY_HOTKEY_* override the overlay's saved hotkeys ("ctrl+shift+space" syntax).
# POSTY_NO_DESKTOP=
# POSTY_URL=http://127.0.0.1:3000
# POSTY_HOTKEY_DUMP=ctrl+shift+space
# POSTY_HOTKEY_HIGHLIGHT=ctrl+shift+h
